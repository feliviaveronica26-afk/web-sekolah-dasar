# Website ini tidak memerlukan variabel rahasia. Akun & password (termasuk Kepala Sekolah)
# tersimpan di database backend Laravel; ganti password dengan:
#   php artisan akun:password "<username>"
#
# Alamat backend Laravel untuk proxy /api (opsional, bawaan http://127.0.0.1:8000).
# Diatur lewat variabel lingkungan saat menjalankan npm run dev, bukan di file ini.
